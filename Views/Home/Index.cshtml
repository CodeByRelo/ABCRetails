@{
    ViewData["Title"] = "Home";
}

<!-- ================= HERO ================= -->

<section class="hero">

    <div class="row align-items-center g-5">

        <!-- Left Content -->

        <div class="col-lg-6">

            <span class="badge bg-light text-secondary px-3 py-2 mb-3">

                <i class="fa-brands fa-microsoft me-2"></i>

                Microsoft Azure Powered Retail Management System

            </span>

            <h1 class="display-3 fw-bold mb-4">

                ABC Retail
                <br />

                <span class="text-white">
                    Management System
                </span>

            </h1>

            <p class="lead mb-4">

                A modern cloud-powered retail management solution built with
                <strong>ASP.NET Core MVC</strong> and
                <strong>Microsoft Azure Storage Services</strong>.
                Manage customers, products, orders and application logs through
                a secure, responsive and scalable web application.

            </p>

            <div class="row mb-4">

                <div class="col-6">

                    <div class="d-flex align-items-center">

                        <i class="fa-solid fa-circle-check text-success fs-4 me-3"></i>

                        <span>Azure Table Storage</span>

                    </div>

                </div>

                <div class="col-6">

                    <div class="d-flex align-items-center">

                        <i class="fa-solid fa-circle-check text-success fs-4 me-3"></i>

                        <span>Azure Blob Storage</span>

                    </div>

                </div>

                <div class="col-6 mt-3">

                    <div class="d-flex align-items-center">

                        <i class="fa-solid fa-circle-check text-success fs-4 me-3"></i>

                        <span>Azure Queue Storage</span>

                    </div>

                </div>

                <div class="col-6 mt-3">

                    <div class="d-flex align-items-center">

                        <i class="fa-solid fa-circle-check text-success fs-4 me-3"></i>

                        <span>Azure Files</span>

                    </div>

                </div>

            </div>

            <div class="d-flex flex-wrap gap-3">

                <a asp-controller="Customer"
                   asp-action="Index"
                   class="btn btn-light btn-lg">

                    <i class="fa-solid fa-users me-2"></i>

                    Manage Customers

                </a>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="btn btn-outline-light btn-lg">

                    <i class="fa-solid fa-box-open me-2"></i>

                    Browse Products

                </a>

            </div>

        </div>

        <!-- Right Content -->

        <div class="col-lg-6">

            <div class="card border-0 shadow-lg rounded-4">

                <div class="card-header bg-light text-black py-3">

                    <h5 class="mb-0">

                        <i class="fa-solid fa-cloud me-2"></i>

                        Azure Storage Overview

                    </h5>

                </div>

                <div class="card-body p-4">

                    <div class="row g-4">

                        <div class="col-6">

                            <div class="text-center">

                                <i class="fa-solid fa-table fa-3x text-secondary mb-3"></i>

                                <h6 class="fw-bold">

                                    Table Storage

                                </h6>

                                <small class="text-muted">

                                    Customers & Products

                                </small>

                            </div>

                        </div>

                        <div class="col-6">

                            <div class="text-center">

                                <i class="fa-solid fa-image fa-3x text-secondary mb-3"></i>

                                <h6 class="fw-bold">

                                    Blob Storage

                                </h6>

                                <small class="text-muted">

                                    Product Images

                                </small>

                            </div>

                        </div>

                        <div class="col-6">

                            <div class="text-center">

                                <i class="fa-solid fa-list-check fa-3x text-secondary mb-3"></i>

                                <h6 class="fw-bold">

                                    Queue Storage

                                </h6>

                                <small class="text-muted">

                                    Order Processing

                                </small>

                            </div>

                        </div>

                        <div class="col-6">

                            <div class="text-center">

                                <i class="fa-solid fa-folder-open fa-3x text-secondary mb-3"></i>

                                <h6 class="fw-bold">

                                    Azure Files

                                </h6>

                                <small class="text-muted">

                                    Application Logs

                                </small>

                            </div>

                        </div>

                    </div>

                    <hr class="my-4" />

                    <div class="text-center">

                        <h5 class="fw-bold mb-3">

                            One Platform.
                            Four Azure Storage Services.

                        </h5>

                        <p class="text-muted mb-0">

                            Demonstrating enterprise cloud integration using
                            Microsoft Azure Storage within an ASP.NET Core MVC
                            application.

                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- ================= SYSTEM MODULES ================= -->

<section class="mb-5">

    <div class="text-center mb-5">

        <h2 class="section-title">

            Explore the System

        </h2>

        <p class="section-subtitle">

            ABC Retail is organised into four core modules, each demonstrating a different aspect of Microsoft Azure Storage Services.

        </p>

    </div>

    <div class="row g-4">

        <!-- Customers -->

        <div class="col-lg-3 col-md-6">

            <div class="card product-card h-100 border-0 shadow-sm">

                <div class="card-body text-center p-4">

                    <div class="mb-4">

                        <i class="fa-solid fa-users fa-4x text-secondary"></i>

                    </div>

                    <h4 class="fw-bold mb-3">

                        Customers

                    </h4>

                    <p class="text-muted mb-4">

                        Create, view and manage customer profiles securely stored using Azure Table Storage.

                    </p>

                    <a asp-controller="Customer"
                       asp-action="Index"
                       class="btn btn-primary w-100">

                        <i class="fa-solid fa-arrow-right me-2"></i>

                        Manage Customers

                    </a>

                </div>

            </div>

        </div>

        <!-- Products -->

        <div class="col-lg-3 col-md-6">

            <div class="card product-card h-100 border-0 shadow-sm">

                <div class="card-body text-center p-4">

                    <div class="mb-4">

                        <i class="fa-solid fa-box-open fa-4x text-secondary"></i>

                    </div>

                    <h4 class="fw-bold mb-3">

                        Products

                    </h4>

                    <p class="text-muted mb-4">

                        Manage products, pricing, stock levels and upload product images to Azure Blob Storage.

                    </p>

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="btn btn-primary w-100">

                        <i class="fa-solid fa-arrow-right me-2"></i>

                        View Products

                    </a>

                </div>

            </div>

        </div>

        <!-- Orders -->

        <div class="col-lg-3 col-md-6">

            <div class="card product-card h-100 border-0 shadow-sm">

                <div class="card-body text-center p-4">

                    <div class="mb-4">

                        <i class="fa-solid fa-cart-shopping fa-4x text-secondary"></i>

                    </div>

                    <h4 class="fw-bold mb-3">

                        Orders

                    </h4>

                    <p class="text-muted mb-4">

                        Create customer orders that are processed and stored using Azure Queue Storage.

                    </p>

                    <a asp-controller="Order"
                       asp-action="Index"
                       class="btn btn-primary w-100">

                        <i class="fa-solid fa-arrow-right me-2"></i>

                        View Orders

                    </a>

                </div>

            </div>

        </div>

        <!-- Logs -->

        <div class="col-lg-3 col-md-6">

            <div class="card product-card h-100 border-0 shadow-sm">

                <div class="card-body text-center p-4">

                    <div class="mb-4">

                        <i class="fa-solid fa-file-lines fa-4x text-secondary"></i>

                    </div>

                    <h4 class="fw-bold mb-3">

                        System Logs

                    </h4>

                    <p class="text-muted mb-4">

                        View and download application log files automatically stored in Azure Files.

                    </p>

                    <a asp-controller="Log"
                       asp-action="Index"
                       class="btn btn-primary w-100">

                        <i class="fa-solid fa-arrow-right me-2"></i>

                        View Logs

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- ================= AZURE STORAGE ARCHITECTURE ================= -->

<section class="mb-5">

    <div class="text-center mb-5">

        <h2 class="section-title">

            Microsoft Azure Storage Architecture

        </h2>

        <p class="section-subtitle">

            ABC Retail demonstrates the practical integration of multiple Microsoft Azure Storage Services, with each service responsible for a specific part of the application's functionality.

        </p>

    </div>

    <div class="row g-4">

        <!-- Azure Table Storage -->

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-4">

                        <div class="me-4">

                            <i class="fa-solid fa-table fa-3x text-secondary"></i>

                        </div>

                        <div>

                            <h3 class="fw-bold mb-1">

                                Azure Table Storage

                            </h3>

                            <p class="text-muted mb-0">

                                NoSQL data storage

                            </p>

                        </div>

                    </div>

                    <p>

                        Customer profiles and product information are stored in Azure Table Storage,
                        providing fast, scalable and schema-less NoSQL data storage for the application.

                    </p>

                    <ul class="list-unstyled mt-4">

                        <li class="mb-2">

                            <i class="fa-solid fa-circle-check text-success me-2"></i>

                            Customer Profiles

                        </li>

                        <li class="mb-2">

                            <i class="fa-solid fa-circle-check text-success me-2"></i>

                            Product Catalogue

                        </li>

                        <li>

                            <i class="fa-solid fa-circle-check text-success me-2"></i>

                            Fast Cloud Storage

                        </li>

                    </ul>

                </div>

            </div>

        </div>

        <!-- Azure Blob Storage -->

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-4">

                        <div class="me-4">

                            <i class="fa-solid fa-image fa-3x text-secondary"></i>

                        </div>

                        <div>

                            <h3 class="fw-bold mb-1">

                                Azure Blob Storage

                            </h3>

                            <p class="text-muted mb-0">

                                Media & image storage

                            </p>

                        </div>

                    </div>

                    <p>

                        Product images are uploaded to Azure Blob Storage and securely retrieved using
                        Shared Access Signature (SAS) URLs generated by the application.

                    </p>

                    <ul class="list-unstyled mt-4">

                        <li class="mb-2">

                            <i class="fa-solid fa-circle-check text-success me-2"></i>

                            Product Images

                        </li>

                        <li class="mb-2">

                            <i class="fa-solid fa-circle-check text-success me-2"></i>

                            Private Blob Container

                        </li>

                        <li>

                            <i class="fa-solid fa-circle-check text-success me-2"></i>

                            Secure SAS Access

                        </li>

                    </ul>

                </div>

            </div>

        </div>

        <!-- Azure Queue Storage -->

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-4">

                        <div class="me-4">

                            <i class="fa-solid fa-list-check fa-3x text-secondary"></i>

                        </div>

                        <div>

                            <h3 class="fw-bold mb-1">

                                Azure Queue Storage

                            </h3>

                            <p class="text-muted mb-0">

                                Asynchronous processing

                            </p>

                        </div>

                    </div>

                    <p>

                        Orders are submitted to Azure Queue Storage where they can be processed
                        asynchronously, enabling reliable communication between application components.

                    </p>

                    <ul class="list-unstyled mt-4">

                        <li class="mb-2">

                            <i class="fa-solid fa-circle-check text-success me-2"></i>

                            Customer Orders

                        </li>

                        <li class="mb-2">

                            <i class="fa-solid fa-circle-check text-success me-2"></i>

                            Inventory Processing

                        </li>

                        <li>

                            <i class="fa-solid fa-circle-check text-success me-2"></i>

                            Reliable Message Queue

                        </li>

                    </ul>

                </div>

            </div>

        </div>

        <!-- Azure Files -->

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-4">

                        <div class="me-4">

                            <i class="fa-solid fa-folder-open fa-3x text-secondary"></i>

                        </div>

                        <div>

                            <h3 class="fw-bold mb-1">

                                Azure Files

                            </h3>

                            <p class="text-muted mb-0">

                                Shared cloud file storage

                            </p>

                        </div>

                    </div>

                    <p>

                        Application events are automatically written to log files and stored in Azure Files,
                        allowing administrators to download and review system activity whenever required.

                    </p>

                    <ul class="list-unstyled mt-4">

                        <li class="mb-2">

                            <i class="fa-solid fa-circle-check text-success me-2"></i>

                            Application Logs

                        </li>

                        <li class="mb-2">

                            <i class="fa-solid fa-circle-check text-success me-2"></i>

                            Downloadable Log Files

                        </li>

                        <li>

                            <i class="fa-solid fa-circle-check text-success me-2"></i>

                            Centralised File Storage

                        </li>

                    </ul>

                </div>

            </div>

        </div>

    </div>

</section>

