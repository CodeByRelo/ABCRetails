    <div class="container">

        <div class="row justify-content-center text-center">

            <div class="col-lg-10">

                <span class="badge bg-light text-secondary px-3 py-2 mb-3">

                    Cloud Computing Assignment

                </span>

                <h2 class="display-5 fw-bold mb-4 text-white">

                    Bringing Microsoft Azure Storage Services Together
                </h2>


            </div>

        </div>



        <!-- Assignment Objectives -->

        <div class="row g-4 mb-5">

            <div class="col-lg-3 col-md-6">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body text-center p-4">

                        <i class="fa-solid fa-circle-check fa-3x text-success mb-3"></i>

                        <h5 class="fw-bold">

                            Azure Tables

                        </h5>

                        <p class="mb-0 text-secondary">

                            Customer and product information stored securely using
                            Azure Table Storage.

                        </p>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body text-center p-4">

                        <i class="fa-solid fa-circle-check fa-3x text-success mb-3"></i>

                        <h5 class="fw-bold">

                            Azure Blobs

                        </h5>

                        <p class="mb-0 text-secondary">

                            Product images uploaded and retrieved securely from
                            Azure Blob Storage.

                        </p>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body text-center p-4">

                        <i class="fa-solid fa-circle-check fa-3x text-success mb-3"></i>

                        <h5 class="fw-bold">

                            Azure Queues

                        </h5>

                        <p class="mb-0 text-secondary">

                            Order processing messages managed through Azure Queue
                            Storage.

                        </p>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body text-center p-4">

                        <i class="fa-solid fa-circle-check fa-3x text-success mb-3"></i>

                        <h5 class="fw-bold">

                            Azure Files

                        </h5>

                        <p class="mb-0 text-secondary">

                            Application log files automatically generated and stored
                            using Azure Files.

                        </p>

                    </div>

                </div>

            </div>

        </div>



        <!-- Quick Navigation -->

        <div class="text-center">

            <h3 class="fw-bold mb-4 text-white">

                Explore the Application

            </h3>

            <div class="d-flex flex-wrap justify-content-center gap-3">

                <a asp-controller="Customer"
                   asp-action="Index"
                   class="btn btn-light btn-lg">

                    <i class="fa-solid fa-users me-2"></i>

                    Customers

                </a>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="btn btn-light btn-lg">

                    <i class="fa-solid fa-box-open me-2"></i>

                    Products

                </a>

                <a asp-controller="Order"
                   asp-action="Index"
                   class="btn btn-light btn-lg">

                    <i class="fa-solid fa-cart-shopping me-2"></i>

                    Orders

                </a>

                <a asp-controller="Log"
                   asp-action="Index"
                   class="btn btn-light btn-lg">

                    <i class="fa-solid fa-file-lines me-2"></i>

                    System Logs

                </a>

            </div>

            <hr class="my-5 border-light opacity-25" />

        </div>

    </div>

</section>