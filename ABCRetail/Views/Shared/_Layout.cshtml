<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] | ABC Retail</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ABCRetail.styles.css" asp-append-version="true" />
</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top py-3">

        <div class="container">

            <a class="navbar-brand fw-bold fs-3" asp-controller="Home" asp-action="Index">

                <i class="fa-solid fa-store me-2"></i>

                ABC Retail

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbar">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="navbar">

                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item mx-2">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            <i class="fa-solid fa-house me-1"></i>

                            Home

                        </a>
                    </li>

                    <li class="nav-item mx-2">
                        <a class="nav-link"
                           asp-controller="Customer"
                           asp-action="Index">

                            <i class="fa-solid fa-users me-1"></i>

                            Customers

                        </a>
                    </li>

                    <li class="nav-item mx-2">
                        <a class="nav-link"
                           asp-controller="Product"
                           asp-action="Index">

                            <i class="fa-solid fa-box-open me-1"></i>

                            Products

                        </a>
                    </li>

                    <li class="nav-item mx-2">
                        <a class="nav-link"
                           asp-controller="Order"
                           asp-action="Index">

                            <i class="fa-solid fa-cart-shopping me-1"></i>

                            Orders

                        </a>
                    </li>

                    <li class="nav-item mx-2">
                        <a class="nav-link"
                           asp-controller="SystemLogs"
                           asp-action="Index">

                            <i class="fa-solid fa-file-lines me-1"></i>

                            SystemLogs

                        </a>
                    </li>

                    <li class="nav-item mx-2">
                        <a class="nav-link"
                            asp-controller="Home"
                            asp-action="Privacy">

                             <i class="fa-solid fa-shield-halved me-1"></i>

                                 Privacy

                        </a>
                    </li>


                </ul>

            </div>

        </div>

    </nav>

    <!-- ================= MAIN ================= -->

    <main>

        <div class="container py-5">

            @RenderBody()

        </div>

    </main>

    <!-- ================= FOOTER ================= -->

    <footer class="mt-5">

        <div class="container py-5">

            <div class="row g-5">

                <!-- Brand -->

                <div class="col-lg-4">

                    <h3 class="fw-bold mb-3">

                        <i class="fa-solid fa-store me-2 text-secondary"></i>

                        ABC Retail

                    </h3>

                    <p class="text-muted mb-4">

                        A cloud-powered retail management platform built with
                        ASP.NET Core MVC and Microsoft Azure Storage Services.
                        Designed to demonstrate modern cloud application development
                        through scalable, secure and reliable storage solutions.

                    </p>

                    <div class="d-flex gap-3 fs-4">

                        <i class="fa-brands fa-microsoft text-secondary"></i>
                        <i class="fa-brands fa-windows text-secondary"></i>
                        <i class="fa-solid fa-cloud text-secondary"></i>

                    </div>

                </div>

                <!-- System Modules -->

                <div class="col-lg-2">

                    <h5 class="fw-bold mb-3">

                        Modules

                    </h5>

                    <ul class="list-unstyled">

                        <li class="mb-2">
                            <a asp-controller="Home"
                               asp-action="Index"
                               class="footer-link">
                                Home
                            </a>
                        </li>

                        <li class="mb-2">
                            <a asp-controller="Customer"
                               asp-action="Index"
                               class="footer-link">
                                Customers
                            </a>
                        </li>

                        <li class="mb-2">
                            <a asp-controller="Product"
                               asp-action="Index"
                               class="footer-link">
                                Products
                            </a>
                        </li>

                        <li class="mb-2">
                            <a asp-controller="Order"
                               asp-action="Index"
                               class="footer-link">
                                Orders
                            </a>
                        </li>

                        <li>
                            <a asp-controller="SystemLogs"
                               asp-action="Index"
                               class="footer-link">
                                SystemLogs
                            </a>
                        </li>

                    </ul>

                </div>

                <!-- Azure Services -->

                <div class="col-lg-3">

                    <h5 class="fw-bold mb-3">

                        Azure Services

                    </h5>

                    <ul class="list-unstyled">

                        <li class="mb-2">
                            <i class="fa-solid fa-table text-secondary me-2"></i>
                            Azure Table Storage
                        </li>

                        <li class="mb-2">
                            <i class="fa-solid fa-image text-secondary me-2"></i>
                            Azure Blob Storage
                        </li>

                        <li class="mb-2">
                            <i class="fa-solid fa-list-check text-secondary me-2"></i>
                            Azure Queue Storage
                        </li>

                        <li>
                            <i class="fa-solid fa-folder-open text-secondary me-2"></i>
                            Azure Files
                        </li>

                    </ul>

                </div>

                <!-- Technologies -->

                <div class="col-lg-3">

                    <h5 class="fw-bold mb-3">

                        Technology Stack

                    </h5>

                    <div class="d-flex flex-wrap gap-2">

                        <span class="badge bg-primary">ASP.NET Core MVC</span>

                        <span class="badge bg-dark">C#</span>

                        <span class="badge bg-success">Bootstrap 5</span>

                        <span class="badge bg-info text-dark">Azure Storage</span>

                        <span class="badge bg-secondary">Azure Tables</span>

                        <span class="badge bg-secondary">Azure Blobs</span>

                        <span class="badge bg-secondary">Azure Queues</span>

                        <span class="badge bg-secondary">Azure Files</span>

                    </div>

                </div>

            </div>

            <hr class="my-5" />

            <div class="row align-items-center">

                <div class="col-md-6">

                    <p class="mb-0 text-muted">

                        © @DateTime.Now.Year | All Rights Reserved. <strong>By Tshwarelo Lephoto ST10535591</strong>.


                    </p>

                </div>

                <div class="col-md-6 text-md-end">

                    <small class="text-muted">

                        Built using
                        <strong>ASP.NET Core MVC</strong>,
                        <strong>C#</strong>,
                        <strong>Bootstrap 5</strong> &
                        <strong>Microsoft Azure Storage Services</strong>

                    </small>

                </div>

            </div>

        </div>

    </footer>
    <!-- Scripts -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>