@model ABCRetail.Models.Product

@{
    ViewData["Title"] = "Add Product";
}


<div class="container py-5">


    <!-- Page Header -->

    <div class="mb-5">

        <h1 class="fw-bold">
            <i class="fa-solid fa-box-open me-2"></i>
            Add New Product
        </h1>

        <p class="text-muted">
            Create a new product and store information securely using Azure Table Storage and Blob Storage.
        </p>

    </div>





    <div class="row justify-content-center">


        <div class="col-lg-8">


            <div class="card shadow-sm border-0 rounded-4">


                <div class="card-body p-5">


                    <form asp-action="Create"
                          method="post"
                          enctype="multipart/form-data">


                        @Html.AntiForgeryToken()



                        <!-- Product Name -->

                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">

                                <i class="fa-solid fa-tag me-2"></i>
                                Product Name

                            </label>


                            <input asp-for="Name"
                                   class="form-control form-control-lg"
                                   placeholder="Enter product name" />


                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>







                        <!-- Category -->

                        <div class="mb-4">


                            <label asp-for="Category"
                                   class="form-label fw-semibold">

                                <i class="fa-solid fa-layer-group me-2"></i>
                                Category

                            </label>


                            <input asp-for="Category"
                                   class="form-control form-control-lg"
                                   placeholder="Electronics, Clothing, etc." />


                            <span asp-validation-for="Category"
                                  class="text-danger">
                            </span>


                        </div>

                        <!-- Description -->

                        <div class="mb-4">


                            <label asp-for="Description"
                                   class="form-label fw-semibold">


                                <i class="fa-solid fa-align-left me-2"></i>
                                Description


                            </label>



                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Describe the product..."></textarea>



                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>


                        </div>

                        <div class="row">


                            <!-- Price -->

                            <div class="col-md-6 mb-4">


                                <label asp-for="Price"
                                       class="form-label fw-semibold">


                                    <i class="fa-solid fa-money-bill me-2"></i>
                                    Price


                                </label>
                                <input asp-for="Price"
                                       class="form-control form-control-lg"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       placeholder="0.00" />
                                <span asp-validation-for="Price"
                                      class="text-danger">
                                </span>


                            </div>

                            <!-- Stock -->

                            <div class="col-md-6 mb-4">


                                <label asp-for="Stock"
                                       class="form-label fw-semibold">


                                    <i class="fa-solid fa-boxes-stacked me-2"></i>
                                    Stock Quantity


                                </label>




                                <input asp-for="Stock"
                                       class="form-control form-control-lg"
                                       placeholder="0" />



                                <span asp-validation-for="Stock"
                                      class="text-danger">
                                </span>


                            </div>


                        </div>
                        <!-- Image Upload -->
                        <div class="mb-5">


                            <label class="form-label fw-semibold">

                                <i class="fa-solid fa-image me-2"></i>
                                Product Image

                            </label>

                            <input type="file"
                                   name="imageFile"
                                   class="form-control form-control-lg"
                                   accept="image/*" />



                            <small class="text-muted">

                                Image will be uploaded to Azure Blob Storage.

                            </small>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between">


                            <a asp-action="Index"
                               class="btn btn-outline-secondary btn-lg">


                                <i class="fa-solid fa-arrow-left me-2"></i>

                                Back

                            </a>

                            <button type="submit"
                                    class="btn btn-dark btn-lg">


                                <i class="fa-solid fa-cloud-arrow-up me-2"></i>

                                Save Product
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}