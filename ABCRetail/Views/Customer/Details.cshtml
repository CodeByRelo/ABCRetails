@model ABCRetail.Models.Customer

@{
    ViewData["Title"] = "Customer Details";
}

<div class="row justify-content-center">

    <div class="col-xl-8">

        <!-- ================= HEADER ================= -->

        <div class="mb-5">

            <span class="text-uppercase text-muted fw-semibold small">
                Customer Management
            </span>

            <h1 class="display-5 fw-bold mb-2">
                Customer Profile
            </h1>

            <p class="text-muted mb-0">
                View customer information stored securely in Azure Table Storage.
            </p>

        </div>

        <!-- ================= PROFILE CARD ================= -->

        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body p-5">

                <div class="text-center mb-5">

                    <div class="rounded-circle bg-dark text-white d-inline-flex align-items-center justify-content-center mb-4"
                         style="width:120px;height:120px;font-size:2.5rem;">

                        <i class="fa-solid fa-user"></i>

                    </div>

                    <h2 class="fw-bold mb-1">

                        @Model.FirstName @Model.LastName

                    </h2>

                    <span class="badge bg-secondary">

                        Azure Table Storage Customer

                    </span>

                </div>

                <div class="row gy-4">

                    <div class="col-md-6">

                        <div class="border rounded-4 p-4 h-100">

                            <small class="text-muted text-uppercase">

                                Customer ID

                            </small>

                            <h5 class="fw-semibold mt-2 mb-0">

                                @Model.Id

                            </h5>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="border rounded-4 p-4 h-100">

                            <small class="text-muted text-uppercase">

                                Email Address

                            </small>

                            <h5 class="fw-semibold mt-2 mb-0">

                                @Model.Email

                            </h5>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="border rounded-4 p-4 h-100">

                            <small class="text-muted text-uppercase">

                                Phone Number

                            </small>

                            <h5 class="fw-semibold mt-2 mb-0">

                                @Model.PhoneNumber

                            </h5>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="border rounded-4 p-4 h-100">

                            <small class="text-muted text-uppercase">

                                Storage

                            </small>

                            <h5 class="fw-semibold mt-2 mb-0">

                                Azure Table Storage

                            </h5>

                        </div>

                    </div>

                </div>

                <hr class="my-5" />

                <div class="d-flex justify-content-between">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        <i class="fa-solid fa-arrow-left me-2"></i>

                        Back to Customers

                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-danger">

                        <i class="fa-solid fa-trash me-2"></i>

                        Delete Customer

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>