@model ABCRetail.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
}

<div class="row justify-content-center">

    <div class="col-xl-7 col-lg-8">

        <!-- ================= HEADER ================= -->

        <div class="mb-5">

            <span class="text-uppercase text-muted fw-semibold small">
                Customer Management
            </span>

            <h1 class="display-5 fw-bold mb-2">
                Delete Customer
            </h1>

            <p class="text-muted mb-0">
                Permanently remove a customer profile from Azure Table Storage.
            </p>

        </div>

        <!-- ================= WARNING CARD ================= -->

        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body p-5">

                <div class="text-center mb-5">

                    <div class="rounded-circle bg-danger bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-4"
                         style="width:110px;height:110px;">

                        <i class="fa-solid fa-triangle-exclamation fa-3x text-danger"></i>

                    </div>

                    <h2 class="fw-bold">

                        Delete this customer?

                    </h2>

                    <p class="text-muted">

                        This action cannot be undone. Once deleted, the customer
                        record will be permanently removed from Azure Table Storage.

                    </p>

                </div>

                <!-- ================= CUSTOMER INFO ================= -->

                <div class="border rounded-4 p-4 bg-light">

                    <div class="row gy-4">

                        <div class="col-md-6">

                            <small class="text-muted text-uppercase">

                                Full Name

                            </small>

                            <h5 class="fw-semibold mb-0">

                                @Model.FirstName @Model.LastName

                            </h5>

                        </div>

                        <div class="col-md-6">

                            <small class="text-muted text-uppercase">

                                Customer ID

                            </small>

                            <h5 class="fw-semibold mb-0">

                                @Model.Id

                            </h5>

                        </div>

                        <div class="col-md-6">

                            <small class="text-muted text-uppercase">

                                Email

                            </small>

                            <h6 class="fw-normal mb-0">

                                @Model.Email

                            </h6>

                        </div>

                        <div class="col-md-6">

                            <small class="text-muted text-uppercase">

                                Phone Number

                            </small>

                            <h6 class="fw-normal mb-0">

                                @Model.PhoneNumber

                            </h6>

                        </div>

                    </div>

                </div>

                <hr class="my-5" />

                <!-- ================= BUTTONS ================= -->

                <form asp-action="Delete" method="post">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <div class="d-flex justify-content-between">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary btn-lg">

                            <i class="fa-solid fa-arrow-left me-2"></i>

                            Cancel

                        </a>

                        <button type="submit"
                                class="btn btn-danger btn-lg">

                            <i class="fa-solid fa-trash me-2"></i>

                            Delete Customer

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>